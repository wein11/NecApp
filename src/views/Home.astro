---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Stage from '../components/react/Stage.jsx';
import HeroTitle from '../components/react/HeroTitle.jsx';
import AudienceTitle from '../components/react/AudienceTitle.jsx';
import RevealText from '../components/react/RevealText.jsx';
import ProductStack from '../components/react/ProductStack.jsx';
import AnimatedContent from '../components/react/AnimatedContent.jsx';
import { t, langs, homePath, productPath, type Lang } from '../i18n';
import { stageText } from '../i18n/stage';
import { site, company, isPending, type ProductSlug } from '../config';
import { clientes } from '../data/clientes';
import { productPhoto, stack, logos, audiencePhoto } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const alternates = Object.fromEntries(langs.map((l) => [l, homePath(l)])) as Record<Lang, string>;
const pages = d.product.pages;
const wa = isPending(site.whatsapp) ? null : `https://wa.me/${site.whatsapp}`;
const mail = isPending(site.email) ? null : site.email;
const familyOf = (value: string) => (/Anna|Thera/.test(value) ? 'neuro' : 'vicon');
const slugs: ProductSlug[] = ['anna', 'thera', 'nexus', 'polygon'];
const stackItems = slugs.map((s) => ({
  title: pages[s].name,
  tag: pages[s].tagline,
  image: stack[s].src,
  alt: d.solutions.photos[s],
  href: productPath(lang, s),
}));
// Entrada suave y corta para el contenido (reemplaza las anteriores).
const enter = { distance: 32, duration: 0.9, ease: 'power3.out', stagger: 0.08, threshold: 0.15 };
---

<Base lang={lang} title={d.meta.title} description={d.meta.description} alternates={alternates}>
  <div class="split">
    <div class="column">
      <section class="hero" data-signal-section="pulse" aria-labelledby="hero-title">
        <HeroTitle client:load id="hero-title" prefix={d.hero.prefix} lines={d.hero.lines} />
        <p class="lead">{d.hero.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contacto">{d.hero.primary}</a>
          <a class="link-arrow" href="#soluciones">{d.hero.secondary}</a>
        </div>
      </section>

      <section class="proof" data-signal-section="pulse" aria-labelledby="proof-title">
        <AnimatedContent client:load {...enter}>
          <h2 id="proof-title">{d.proof.title}</h2>
          <div class="brand-logos">
            <img src={logos.vicon.src} alt="Vicon" width={logos.vicon.w} height={logos.vicon.h} />
            <img src={logos.neuroears.src} alt="NeuroEars" width={logos.neuroears.w} height={logos.neuroears.h} />
          </div>
          <p class="proof-line">{d.proof.groups[2].items.join(' · ')}</p>
          <p class="in-use">{d.proof.inUse}</p>
        </AnimatedContent>
      </section>

      <section class="areas" id="soluciones" aria-labelledby="sol-title">
        <h2 id="sol-title" class="section-title">{d.solutions.title}</h2>
        {
          d.solutions.areas.map((area) => {
            const prods = area.products as ProductSlug[];
            return (
              <article
                class="area"
                data-signal-section={pages[prods[0]].signal}
                aria-labelledby={`area-${area.id}`}
              >
                <AnimatedContent client:load {...enter}>
                  <h3 id={`area-${area.id}`}>{area.title}</h3>
                  <p class="area-text">{area.text}</p>
                  <div class="area-photos">
                    {prods.map((slug) => (
                      <a
                        class:list={['area-photo', { contain: productPhoto[slug].w / productPhoto[slug].h > 1.4 }]}
                        href={productPath(lang, slug)}
                        data-show-signal={pages[slug].signal}
                      >
                        <img
                          src={productPhoto[slug].src}
                          alt={d.solutions.photos[slug]}
                          width={productPhoto[slug].w}
                          height={productPhoto[slug].h}
                          loading="lazy"
                        />
                        <span class="area-photo-name">
                          {pages[slug].name}
                          <span>{pages[slug].tagline}</span>
                        </span>
                      </a>
                    ))}
                  </div>
                </AnimatedContent>
              </article>
            );
          })
        }
      </section>
    </div>

    <Stage client:load initial="pulse" tabs={['pulse', 'gait', 'nystagmus', 'gaze']} text={stageText(lang)} />
  </div>

  <section class="products" aria-labelledby="prod-title">
    <div class="products-copy">
      <AnimatedContent client:load {...enter}>
        <h2 id="prod-title">{d.products.title}</h2>
        <p>{d.products.text}</p>
        <ul class="product-list">
          {
            slugs.map((s) => (
              <li>
                <a href={productPath(lang, s)}>
                  <span class="pl-name">{pages[s].name}</span>
                  <span class="pl-tag">{pages[s].tagline}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="hint">{d.products.hint}</p>
      </AnimatedContent>
    </div>
    <div class="products-stack" data-ui>
      <ProductStack client:visible items={stackItems} label={d.products.stackLabel} />
    </div>
  </section>

  <section class="audience" id="para-quien" aria-labelledby="aud-title">
    <div class="audience-copy">
      <AudienceTitle client:load id="aud-title" lead={d.audience.lead} words={d.audience.words} />
      <AnimatedContent client:load {...enter} className="audience-groups">
        {
          d.audience.groups.map((g) => (
            <div class="group">
              <h3 class="group-name">{g.name}</h3>
              <ul>
                {g.rows.map(([name, value]) => (
                  <li>
                    <span class="row-name">
                      <span class:list={['dot', familyOf(value)]} aria-hidden="true" />
                      {name}
                    </span>
                    <span class="row-value">{value}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </AnimatedContent>
    </div>
    <figure class="audience-photo">
      <img src={audiencePhoto.src} alt={d.audience.photoAlt} width={audiencePhoto.w} height={audiencePhoto.h} loading="lazy" />
    </figure>
  </section>

  <section class="process" id="como-trabajamos" aria-labelledby="proc-title">
    <div class="process-copy">
      <h2 id="proc-title">{d.process.title}</h2>
      <p>{d.process.text}</p>
    </div>
    <AnimatedContent client:load distance={48} duration={1} ease="power3.out" className="slip-wrap">
      <div class="slip">
        {
          d.process.stages.map((s) => (
            <div class="slip-group">
              <h3>{s.name}</h3>
              <ul>
                {s.rows.map(([what, value]) => (
                  <li>
                    <span>{what}</span>
                    <span class="leader" aria-hidden="true" />
                    <span class="slip-value">{value}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="slip-result">
          <span>{d.process.result[0]}</span>
          <span>{d.process.result[1]}</span>
        </p>
      </div>
    </AnimatedContent>
  </section>

  {
    clientes.length > 0 && (
      <section class="clients" aria-labelledby="cli-title">
        <h2 id="cli-title" class="section-title">
          {d.clients.title}
        </h2>
        <ul>
          {clientes.map((c) => (
            <li>
              {c.cita && <blockquote>{c.cita[lang]}</blockquote>}
              <p class="client-name">{c.institucion}</p>
              {c.autor && (
                <p class="client-author">
                  {c.autor}
                  {c.cargo && `, ${c.cargo[lang]}`}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="about" id="nosotros" aria-labelledby="about-title">
    <div class="letter">
      <h2 id="about-title">{d.about.title}</h2>
      <RevealText client:visible text={d.about.paragraphs[0]} className="reveal-statement" />
      {d.about.paragraphs.slice(1).map((p) => <p>{p}</p>)}
      <p>{d.about.company(company.legalName, company.foundedYear, company.city)}</p>
      <p class="sign">
        {d.about.sign}
        <span>{company.legalName}</span>
      </p>
    </div>
  </section>

  <section class="contact" id="contacto" aria-labelledby="contact-title">
    <div class="contact-copy">
      <h2 id="contact-title">{d.contact.title}</h2>
      <p class="statement">{d.contact.statement}</p>
      {
        (wa || mail) && (
          <div class="direct">
            <p>{d.contact.or}</p>
            {wa && (
              <a href={wa} data-wa="contact" rel="noopener">
                {d.contact.whatsapp}
              </a>
            )}
            {mail && <a href={`mailto:${mail}`}>{d.contact.email}</a>}
          </div>
        )
      }
    </div>
    <div class="contact-form">
      <LeadForm lang={lang} variant="contact" />
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    align-items: start;
  }

  .column {
    padding: 0 var(--margin) var(--gap-section);
    min-width: 0;
  }

  .column > section {
    max-width: 640px;
  }

  /* Hero */
  .hero {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 0 96px;
  }

  .hero :global(.hero-title) {
    font-size: var(--step-display);
    line-height: 1.04;
    letter-spacing: -0.035em;
    min-height: 2.1em;
    display: block;
  }

  .hero :global(.text-type__prefix) {
    display: block;
  }

  .hero :global(.text-type__content > span:not(.text-type__prefix)) {
    color: var(--teal-ink);
  }

  .lead {
    margin-top: 36px;
    font-size: var(--step-lead);
    line-height: 1.5;
    max-width: 34ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
    margin-top: 44px;
  }

  .hero-actions .link-arrow {
    font-size: 1rem;
  }

  .section-title {
    font-size: var(--step-head);
  }

  /* Distribuidores */
  .proof {
    padding-bottom: var(--gap-section);
  }

  .proof h2 {
    font-size: var(--step-sub);
  }

  .brand-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 56px;
    margin: 36px 0 28px;
  }

  .brand-logos img {
    height: 44px;
    width: auto;
  }

  .proof-line {
    font-family: var(--font-display);
    font-weight: 500;
  }

  .in-use {
    margin-top: 8px;
    font-style: italic;
    color: var(--ink-soft);
  }

  /* Áreas con fotos */
  .areas {
    display: grid;
    gap: clamp(80px, 9vw, 140px);
  }

  .area h3 {
    font-size: var(--step-sub);
  }

  .area-text {
    margin-top: 20px;
    max-width: 46ch;
  }

  .area-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 32px;
  }

  .area-photo {
    display: grid;
    gap: 14px;
    text-decoration: none;
    color: var(--navy);
  }

  .area-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #fbfcfd;
    transition: transform 0.6s var(--ease-out);
  }

  .area-photo.contain img {
    object-fit: contain;
    background: var(--navy-deep);
    padding: 12px;
  }

  .area-photo:hover img {
    transform: scale(1.02);
  }

  .area-photo-name {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .area-photo-name span {
    display: block;
    margin-top: 4px;
    font-size: var(--step-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--teal-ink);
  }

  .area-photo:hover .area-photo-name {
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-underline-offset: 6px;
  }

  /* Productos: pila de tarjetas */
  .products {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    padding: var(--gap-section) var(--margin);
    background: var(--paper-2);
    overflow: hidden;
  }

  .products-copy {
    grid-column: 1 / span 5;
    align-self: center;
  }

  .products h2 {
    font-size: var(--step-head);
  }

  .products-copy p {
    margin-top: 24px;
    max-width: 40ch;
  }

  .product-list {
    display: grid;
    gap: 4px;
    margin-top: 36px;
  }

  .product-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 18px 20px;
    background: var(--paper);
    color: var(--navy);
    text-decoration: none;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .product-list a:hover {
    background: var(--navy);
    color: var(--on-navy);
  }

  .pl-name {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 600;
  }

  .pl-tag {
    font-size: var(--step-small);
    text-align: right;
  }

  .products .hint {
    font-size: var(--step-small);
    color: var(--ink-soft);
  }

  .products-stack {
    grid-column: 7 / -1;
    height: 560px;
    align-self: center;
  }

  .products-stack :global(.stack-card) {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    color: var(--on-navy);
    text-decoration: none;
  }

  .products-stack :global(.stack-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 16px 18px;
    font-family: var(--font-display);
  }

  .products-stack :global(.stack-title) {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .products-stack :global(.stack-tag) {
    font-size: 0.875rem;
    color: var(--on-navy-soft);
    text-align: right;
  }

  .products-stack :global(.stack-media) {
    display: block;
    min-height: 0;
    background: var(--navy-deep);
  }

  .products-stack :global(.stack-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Para quién */
  .audience {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    padding: var(--gap-section) var(--margin);
  }

  .audience-copy {
    grid-column: 1 / span 7;
  }

  .audience :global(.audience-title) {
    display: grid;
    justify-items: start;
    gap: 0.12em;
    font-size: var(--step-head);
  }

  .audience :global(.text-rotate-highlight) {
    border-radius: 0;
    padding: 0.02em 0.22em 0.08em;
    color: var(--navy-deep) !important;
  }

  .audience :global(.audience-split) {
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .audience :global(.audience-groups) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 40px;
    margin-top: 56px;
  }

  .group {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .group-name {
    font-family: var(--font-text);
    font-size: var(--step-body);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }

  .group li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 5px 0;
  }

  .row-name {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
  }

  .dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.neuro {
    background: var(--teal);
  }

  .dot.vicon {
    background: var(--navy);
  }

  .row-value {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--ink-soft);
  }

  .audience-photo {
    grid-column: 9 / -1;
    margin: 0;
    align-self: center;
  }

  .audience-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* Cómo trabajamos */
  .process {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    padding: var(--gap-section) var(--margin);
    background: var(--navy);
    color: var(--on-navy);
  }

  .process-copy {
    grid-column: 1 / span 5;
    display: grid;
    gap: 28px;
    align-content: start;
  }

  .process h2 {
    font-size: var(--step-head);
  }

  .process-copy p {
    max-width: 30ch;
    font-size: var(--step-lead);
  }

  .process :global(.slip-wrap) {
    grid-column: 7 / span 5;
  }

  .slip {
    background: var(--paper);
    color: var(--navy);
    padding: 40px 36px 64px;
    clip-path: polygon(
      0 0, 100% 0, 100% calc(100% - 14px),
      95% 100%, 90% calc(100% - 14px), 85% 100%, 80% calc(100% - 14px), 75% 100%, 70% calc(100% - 14px),
      65% 100%, 60% calc(100% - 14px), 55% 100%, 50% calc(100% - 14px), 45% 100%, 40% calc(100% - 14px),
      35% 100%, 30% calc(100% - 14px), 25% 100%, 20% calc(100% - 14px), 15% 100%, 10% calc(100% - 14px),
      5% 100%, 0 calc(100% - 14px)
    );
  }

  .slip-group + .slip-group {
    margin-top: 28px;
  }

  .slip h3 {
    font-size: 1rem;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .slip li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 0;
    font-size: 1rem;
  }

  .leader {
    flex: 1;
    min-width: 24px;
    border-bottom: 4px dotted var(--ink-soft);
    opacity: 0.45;
  }

  .slip-value {
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--teal-ink);
    white-space: nowrap;
  }

  .slip-result {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 32px -36px 0;
    padding: 14px 36px;
    background: var(--navy);
    color: var(--on-navy);
    font-family: var(--font-display);
    font-weight: 500;
  }

  /* Clientes */
  .clients {
    padding: var(--gap-section) var(--margin) 0;
  }

  .clients ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    margin-top: 48px;
  }

  .clients blockquote {
    margin: 0 0 20px;
    font-size: var(--step-lead);
  }

  .client-name {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .client-author {
    color: var(--ink-soft);
  }

  /* Nosotros */
  .about {
    padding: var(--gap-section) var(--margin);
  }

  .letter {
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    gap: 24px;
  }

  .letter h2 {
    font-size: var(--step-head);
  }

  .letter :global(.reveal-statement) {
    margin: 8px 0 16px;
  }

  .letter :global(.reveal-statement .scroll-reveal-text) {
    font-family: var(--font-display);
    font-size: var(--step-sub);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .sign {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 500;
  }

  .sign span {
    display: block;
    font-family: var(--font-text);
    font-size: var(--step-small);
    font-weight: 400;
    color: var(--ink-soft);
  }

  /* Contacto */
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    padding: var(--gap-section) var(--margin);
    background: var(--paper-2);
  }

  .contact-copy {
    grid-column: 1 / span 5;
    display: grid;
    gap: 28px;
    align-content: start;
  }

  .contact h2 {
    font-size: var(--step-head);
  }

  .statement {
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 24ch;
  }

  .direct {
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }

  .direct p {
    font-family: var(--font-display);
    font-weight: 500;
  }

  .direct a {
    width: fit-content;
  }

  .contact-form {
    grid-column: 7 / -1;
  }

  @media (max-width: 1099px) {
    .products-copy,
    .products-stack,
    .audience-copy,
    .audience-photo,
    .process-copy,
    .process :global(.slip-wrap),
    .contact-copy,
    .contact-form {
      grid-column: 1 / -1;
    }

    .products-stack {
      height: 480px;
    }

    .audience-photo {
      max-width: 520px;
    }

    .process :global(.slip-wrap) {
      max-width: 520px;
    }
  }

  @media (max-width: 899px) {
    .split {
      display: flex;
      flex-direction: column-reverse;
    }

    .column {
      position: relative;
      z-index: 1;
      background: var(--paper);
      padding-top: 8px;
    }

    .hero {
      min-height: 0;
      padding: 40px 0 88px;
    }

    .lead {
      margin-top: 24px;
    }

    .hero-actions {
      margin-top: 32px;
    }

    .audience :global(.audience-groups) {
      grid-template-columns: 1fr;
    }

    .products-stack {
      height: 400px;
