---
import { t, homePath, productPath, productSlugs, type Lang } from '../i18n';
import { site, isPending } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const home = homePath(lang);
const year = new Date().getFullYear();
const wa = isPending(site.whatsapp) ? null : `https://wa.me/${site.whatsapp}`;
const mail = isPending(site.email) ? null : site.email;
---

<footer class="site-footer">
  <div class="top">
    <ul class="links">
      {productSlugs.map((s) => <li><a href={productPath(lang, s)}>{d.product.pages[s].name}</a></li>)}
    </ul>
    <ul class="links">
      <li><a href={`${home}#soluciones`}>{d.nav.solutions}</a></li>
      <li><a href={`${home}#como-trabajamos`}>{d.nav.process}</a></li>
      <li><a href={`${home}#nosotros`}>{d.nav.about}</a></li>
      <li><a href={`${home}#contacto`}>{d.nav.contact}</a></li>
    </ul>
    <ul class="links contact">
      {wa && <li><a href={wa} data-wa="footer" rel="noopener">WhatsApp</a></li>}
      {mail && <li><a href={`mailto:${mail}`}>{mail}</a></li>}
      <li><a href={`${home}#contacto`}>{d.nav.cta}</a></li>
    </ul>
  </div>

  <div class="mark" data-footer-mark>
    <img src="/brand/logo-light.webp" alt="NecApp, Health solution. Software & application" width="900" height="266" loading="lazy" />
  </div>

  <div class="legal">
    <p>{d.footer.legal}</p>
    <p>{d.footer.marks}</p>
    <p>© {year} NecApp. {d.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--on-navy);
    padding: clamp(56px, 8vw, 104px) var(--margin) 40px;
    overflow: hidden;
  }

  .top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    max-width: 960px;
  }

  .links {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .links a {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--on-navy);
    text-decoration-color: transparent;
    overflow-wrap: anywhere;
  }

  .links a:hover {
    color: var(--teal-light);
    text-decoration-color: var(--teal-light);
  }

  .mark {
    margin-top: clamp(80px, 14vw, 200px);
  }

  .mark img {
    width: 100%;
    height: auto;
  }

  .legal {
    display: grid;
    gap: 4px;
    margin-top: 40px;
    max-width: 72ch;
    font-size: var(--step-small);
    color: var(--on-navy-soft);
  }

  @media (max-width: 699px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }

    .contact {
      grid-column: 1 / -1;
    }
  }
</style>
