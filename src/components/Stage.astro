---
import { t, type Lang } from '../i18n';
import {
  VIEW,
  PLOT,
  SWING_START,
  toPath,
  gaitPoints,
  gaitBand,
  nystagmusPoints,
  gazePoints,
  pulsePoints,
} from '../scripts/signals';
import type { SignalId } from '../scripts/signals';

interface Props {
  lang: Lang;
  initial: SignalId;
  tabs: SignalId[];
}

const { lang, initial, tabs } = Astro.props;
const d = t(lang).stage;

// Plantillas de lectura para el script del cliente.
const templates = {
  pulse: d.readout.pulse(72),
  gait: d.readout.gait('{pct}' as any, '{deg}' as any, '{phase}'),
  report: d.readout.report('{pct}' as any, '{l}' as any, '{r}' as any),
  nystagmus: d.readout.nystagmus('{t}', '{v}' as any),
  gaze: d.readout.gaze('{t}', '{err}'),
  stance: d.readout.stance,
  swing: d.readout.swing,
  axis: d.axis,
  locale: lang === 'pt' ? 'pt-BR' : lang,
};

const swingX = PLOT.x0 + ((PLOT.x1 - PLOT.x0) * SWING_START) / 100;
const gaitPath = toPath(gaitPoints());
const leftPath = toPath(gaitPoints(4, 0.88));
const band = gaitBand();
const dirR = { es: 'D', en: 'R', pt: 'D' }[lang];
const dirL = { es: 'I', en: 'L', pt: 'E' }[lang];
const yFor = (deg: number) => PLOT.y1 - ((deg + 5) / 80) * (PLOT.y1 - PLOT.y0);
---

<aside
  class="stage"
  data-stage
  data-signal={initial}
  data-templates={JSON.stringify(templates)}
  aria-label={d.label}
>
  <div class="stage-inner" data-ui>
    <div class="stage-top">
      <p class="stage-axis" data-axis>{d.axis[initial]}</p>
      {
        tabs.length > 1 && (
          <div class="stage-tabs" role="group" aria-label={d.label}>
            {tabs.map((id) => (
              <button type="button" data-tab={id} aria-pressed={id === initial ? 'true' : 'false'}>
                {d.signals[id]}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div
      class="stage-plot"
      data-plot
      tabindex="0"
      role="slider"
      aria-label={d.hint}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="72"
    >
      <svg viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <clipPath id="plot-clip">
            <rect x={PLOT.x0} y="0" width={PLOT.x1 - PLOT.x0} height={VIEW.h} />
          </clipPath>
        </defs>

        <g data-layer="pulse" clip-path="url(#plot-clip)">
          <path class="trace" data-pulse d={toPath(pulsePoints())} />
        </g>

        <g data-layer="gait">
          <rect class="swing-field" x={swingX} y={PLOT.y0 - 30} width={PLOT.x1 - swingX} height={PLOT.y1 - PLOT.y0 + 30} />
          <path class="band" d={band} />
          <path class="trace" data-draw d={gaitPath} />
          <text class="tick" x={PLOT.x0} y={PLOT.y1 + 44}>0%</text>
          <text class="tick" x={swingX} y={PLOT.y1 + 44}>{SWING_START}%</text>
          <text class="tick end" x={PLOT.x1} y={PLOT.y1 + 44}>100%</text>
          <text class="tick" x={PLOT.x0 + 8} y={PLOT.y0 - 2}>{d.readout.stance}</text>
          <text class="tick" x={swingX + 14} y={PLOT.y0 - 2}>{d.readout.swing}</text>
          <text class="tick end" x={PLOT.x0 - 12} y={yFor(0) + 8}>0°</text>
          <text class="tick end" x={PLOT.x0 - 12} y={yFor(60) + 8}>60°</text>
        </g>

        <g data-layer="report">
          <rect class="swing-field" x={swingX} y={PLOT.y0 - 30} width={PLOT.x1 - swingX} height={PLOT.y1 - PLOT.y0 + 30} />
          <path class="band" d={band} />
          <path class="trace trace-soft" data-draw d={leftPath} />
          <path class="trace" data-draw d={gaitPath} />
          <text class="tick" x={PLOT.x0} y={PLOT.y1 + 44}>0%</text>
          <text class="tick end" x={PLOT.x1} y={PLOT.y1 + 44}>100%</text>
          <text class="tick end" x={PLOT.x0 - 12} y={yFor(0) + 8}>0°</text>
          <text class="tick end" x={PLOT.x0 - 12} y={yFor(60) + 8}>60°</text>
        </g>

        <g data-layer="nystagmus">
          <path class="trace" data-draw d={toPath(nystagmusPoints())} />
          <text class="tick" x={PLOT.x0} y={PLOT.y1 + 44}>0 s</text>
          <text class="tick end" x={PLOT.x1} y={PLOT.y1 + 44}>8 s</text>
          <text class="tick end" x={PLOT.x0 - 12} y={PLOT.y0 + 8}>{dirR}</text>
          <text class="tick end" x={PLOT.x0 - 12} y={PLOT.y1 + 8}>{dirL}</text>
        </g>

        <g data-layer="gaze">
          <path class="trace trace-soft" data-draw d={toPath(gazePoints('head'))} />
          <path class="trace" data-draw d={toPath(gazePoints('eye'))} />
          <text class="tick" x={PLOT.x0} y={PLOT.y1 + 44}>0 s</text>
          <text class="tick end" x={PLOT.x1} y={PLOT.y1 + 44}>4 s</text>
        </g>

        <g class="cursor" data-cursor>
          <rect data-cursor-bar x="0" y={PLOT.y0 - 30} width="3" height={PLOT.y1 - PLOT.y0 + 30} />
          <circle data-cursor-dot cx="0" cy="0" r="11" />
          <circle data-cursor-dot2 cx="0" cy="0" r="8" />
        </g>
      </svg>
    </div>

    <div class="stage-bottom">
      <p class="readout" data-readout aria-live="polite">{templates.pulse}</p>
      <p class="caption">{d.caption}</p>
    </div>
  </div>
</aside>

<style>
  .stage {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    background: var(--navy);
    color: var(--on-navy);
    overflow: hidden;
  }

  .stage-inner {
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: clamp(20px, 3vw, 44px);
    gap: 16px;
  }

  .stage-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .stage-axis {
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--on-navy-soft);
    letter-spacing: 0;
  }

  .stage-tabs {
    display: flex;
    gap: 4px;
    background: var(--navy-deep);
    padding: 4px;
  }

  .stage-tabs button {
    font: 500 var(--step-small) / 1 var(--font-display);
    color: var(--on-navy-soft);
    background: transparent;
    border: 0;
    padding: 12px 16px;
    min-height: 44px;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .stage-tabs button:hover {
    color: var(--on-navy);
  }

  .stage-tabs button[aria-pressed='true'] {
    background: var(--teal);
    color: var(--navy-deep);
  }

  .stage-plot {
    position: relative;
    min-height: 0;
    display: grid;
    place-items: center;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .stage-plot:focus-visible {
    outline-color: var(--teal-light);
    outline-offset: -3px;
  }

  .stage-plot svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  [data-layer] {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out), visibility 0s linear 0.6s;
  }

  .stage[data-signal='pulse'] [data-layer='pulse'],
  .stage[data-signal='gait'] [data-layer='gait'],
  .stage[data-signal='report'] [data-layer='report'],
  .stage[data-signal='nystagmus'] [data-layer='nystagmus'],
  .stage[data-signal='gaze'] [data-layer='gaze'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--ease-out), visibility 0s;
  }

  .trace {
    fill: none;
    stroke: var(--teal-light);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trace-soft {
    stroke: var(--on-navy-soft);
    stroke-width: 4;
    stroke-dasharray: 2 12;
  }

  .band {
    fill: var(--teal);
    opacity: 0.22;
  }

  .swing-field {
    fill: var(--navy-2);
  }

  .tick {
    font-family: var(--font-display);
    font-size: 22px;
    fill: var(--on-navy-soft);
  }

  .tick.end {
    text-anchor: end;
  }

  .cursor {
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  .stage[data-reading='true']:not([data-signal='pulse']) .cursor {
    opacity: 1;
  }

  [data-cursor-bar] {
    fill: var(--on-navy-soft);
    opacity: 0.5;
  }

  [data-cursor-dot] {
    fill: var(--teal-light);
    stroke: var(--navy);
    stroke-width: 4;
  }

  [data-cursor-dot2] {
    fill: var(--on-navy);
    stroke: var(--navy);
    stroke-width: 4;
    opacity: 0;
  }

  .stage[data-signal='report'] [data-cursor-dot2],
  .stage[data-signal='gaze'] [data-cursor-dot2] {
    opacity: 1;
  }

  .stage-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
  }

  .readout {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    min-height: 1.6em;
  }

  .caption {
    font-size: var(--step-small);
    color: var(--on-navy-soft);
  }

  @media (max-width: 899px) {
    .stage {
      height: 56svh;
      min-height: 340px;
    }

    .stage-inner {
      padding: 16px;
    }

    .tick {
      font-size: 30px;
    }
  }
</style>
