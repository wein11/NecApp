---
import { t, homePath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const d = t(lang).nav;
const home = homePath(lang);
const links = [
  ['soluciones', d.solutions],
  ['para-quien', d.audience],
  ['como-trabajamos', d.process],
  ['nosotros', d.about],
  ['contacto', d.contact],
];
---

<header class="site-header">
  <a class="brand" href={home} aria-label={`NecApp, ${d.home}`}>
    <img src="/brand/logo-mark.webp" alt="NecApp" width="640" height="169" />
  </a>

  <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
    <span class="visually-hidden">Menu</span>
    <span class="bars" aria-hidden="true"></span>
  </button>

  <div class="menu" id="site-menu" data-menu data-open="false">
    <nav aria-label="Principal">
      <ul>
        {links.map(([id, label]) => <li><a href={`${home}#${id}`}>{label}</a></li>)}
      </ul>
    </nav>
    <ul class="langs" aria-label={d.language}>
      {
        langs.map((l) => (
          <li>
            <a
              href={alternates[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary cta" href={`${home}#contacto`}>{d.cta}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
    padding: 0 var(--margin);
    background: var(--paper);
  }

  .brand img {
    width: auto;
    height: 34px;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 40px);
  }

  nav ul,
  .langs {
    display: flex;
    gap: clamp(14px, 1.8vw, 28px);
  }

  nav a,
  .langs a {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    padding: 10px 0;
    transition: text-decoration-color 0.3s var(--ease-out), text-underline-offset 0.3s var(--ease-out);
  }

  nav a:hover {
    text-decoration-color: var(--teal);
    text-underline-offset: 5px;
  }

  .langs {
    gap: 4px;
    background: var(--paper-2);
    padding: 4px;
  }

  .langs a {
    display: block;
    padding: 8px 10px;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .langs a:hover {
    color: var(--navy);
  }

  .langs a[aria-current='true'] {
    background: var(--navy);
    color: var(--on-navy);
  }

  .cta {
    min-height: 48px;
    padding: 0 22px;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 1099px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 0;
      background: var(--paper-2);
      cursor: pointer;
    }

    .bars,
    .bars::before,
    .bars::after {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--navy);
      transition: transform 0.3s var(--ease-out), opacity 0.2s;
    }

    .bars {
      position: relative;
    }

    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .bars::before {
      top: -7px;
    }

    .bars::after {
      top: 7px;
    }

    [aria-expanded='true'] .bars {
      background: transparent;
    }

    [aria-expanded='true'] .bars::before {
      transform: translateY(7px) rotate(45deg);
    }

    [aria-expanded='true'] .bars::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    .menu {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 24px var(--margin) 32px;
      background: var(--paper);
      box-shadow: 0 24px 40px -24px rgb(3 42 95 / 0.35); /* taste-skill-ignore: menú desplegado, flota sobre la página */
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease-out),
        transform 0.3s var(--ease-out),
        visibility 0s linear 0.3s;
    }

    .menu[data-open='true'] {
      transform: none;
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.3s var(--ease-out),
        transform 0.3s var(--ease-out);
    }

    nav ul {
      flex-direction: column;
      gap: 0;
    }

    nav a {
      display: block;
      font-size: 1.375rem;
      padding: 12px 0;
    }

    .langs {
      align-self: flex-start;
    }
  }

  @media (max-width: 1099px) and (scripting: none) {
    .menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none; /* taste-skill-ignore */
    }

    .menu-toggle {
      display: none;
    }

    .site-header {
      height: auto;
      flex-wrap: wrap;
      padding-block: 16px;
    }
  }
</style>
